#!/bin/sh
# Template for the `fettle` launcher. Two things generate one from it:
#
#   packaging/install.sh      the distro packages' /usr/bin/fettle   (runs -m fettle)
#   packaging/zipapp/build.sh the archive's ./fettle                 (runs fettle.pyz)
#
# It is a template rather than two scripts because the interpreter search below is the
# fiddly part, and two copies of a fiddly thing is one copy that silently stops matching.
#
# Two placeholders are substituted at generation time — one for the setup line, one for
# what to hand the interpreter. They are not named here on purpose: sed would rewrite
# this comment too, and the generated launcher would carry a mangled explanation of
# itself. See the sed invocations in the two scripts above.
#
# tests/test_packaging.py checks both generated launchers still contain the search, so a
# substitution that quietly produced nothing fails rather than ships.
@SETUP@

# fettle needs python 3.11 or newer, and `python3` is NOT reliably that: on RHEL/Rocky/
# Alma 9 it is 3.9, and on Ubuntu 22.04 it is 3.10, while both have a newer interpreter
# available under a versioned name. Running fettle under the old one fails somewhere
# further in, with an error about whatever 3.11 feature it reached first.
#
# The versioned names come first because the name alone guarantees the version — no
# interpreter has to be started to find out, which keeps the common path free of an
# extra process (bash completion runs this on every tab press). The list is an
# optimisation, not the correctness: a python newer than anything named here is found by
# the `python3` fallback, which checks properly.
for _py in python3.14 python3.13 python3.12 python3.11; do
    command -v "$_py" >/dev/null 2>&1 && exec "$_py" @TARGET@ "$@"
done
if command -v python3 >/dev/null 2>&1 &&
   python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec python3 @TARGET@ "$@"
fi

echo "fettle: needs python 3.11 or newer, and none was found." >&2
echo "  RHEL/Rocky/Alma 9:  sudo dnf install python3.11" >&2
echo "  Ubuntu 22.04:       sudo apt install python3.11" >&2
exit 1

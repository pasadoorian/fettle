include LICENSE README.md CHANGELOG.md PARITY.md fettle.toml.example
include bin/fettle scripts/setup-dev.sh
recursive-include docs *.md
recursive-include constraints *.txt
recursive-include packaging *.sh *.spec *.in *.md PKGBUILD
recursive-include .github *.yml
recursive-include contrib *.bash *.lua
recursive-include tests *.py *.md *.example
recursive-include tests/fixtures *
exclude CLAUDE.md PLAN.md tests/lab/lab.conf
prune tests/lab/matrix-logs
